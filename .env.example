# Omi Companion Capture App - example configuration
# Copy to `.env` and fill in. `./scripts/setup.sh` and `./run.sh` generate this
# file automatically if it is missing.

# API Authentication (REQUIRED)
# Shared secret every client must present as the `X-API-Key` header. Without it
# the backend refuses every endpoint except /health with 503 - it fails closed,
# it does not fall back to open access.
# Generate one with: openssl rand -hex 32
OMI_COMPANION_API_KEY=

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=moondream:1.8b-v2-fp16
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30

# BLE Configuration
BLE_DEVICE_NAME=Omi
BLE_SCAN_TIMEOUT=10
BLE_CONNECTION_TIMEOUT=10

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
WHISPER_MODEL=base

# Video Configuration
VIDEO_FPS=10
VIDEO_WIDTH=640
VIDEO_HEIGHT=480

# AI Feature Toggles
ENABLE_FACE_RECOGNITION=true
ENABLE_OBJECT_DETECTION=true
ENABLE_OCR=true
ENABLE_GESTURE_DETECTION=true
ENABLE_EMOTION_ANALYSIS=true

# Confidence Thresholds
CONFIDENCE_THRESHOLD=0.7
FACE_RECOGNITION_THRESHOLD=0.8
OBJECT_DETECTION_THRESHOLD=0.6

# Storage Configuration
DATABASE_PATH=data/events.db
JSON_BACKUP_PATH=data/events_backup.json
FACE_DB_PATH=data/face_embeddings.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Omi API Configuration (optional - enables the /api/omi/* passthrough routes)
OMI_API_KEY=
OMI_API_URL=https://api.omi.me

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/omi_companion.log
